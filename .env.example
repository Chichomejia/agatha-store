# Opción local: ruta al JSON fuera del repositorio. En producción, usa credenciales administradas del alojamiento.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternativa: JSON de cuenta de servicio guardado como secreto privado del servidor.
# No uses el prefijo NEXT_PUBLIC_ ni lo compartas.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Clave pública del sitio reCAPTCHA Enterprise (Fraud Defense) para Firebase App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Nombre público de Cloudinary usado por los formularios de imágenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
