rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'chichomejiab@gmail.com',
          'christine.gomez0209@icloud.com'
        ];
    }

    function validOrderStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.status == 'pendiente'
            && request.resource.data.status in ['confirmado', 'cancelado'])
          || (resource.data.status == 'confirmado'
            && request.resource.data.status in ['enviado', 'cancelado'])
          || (resource.data.status == 'enviado'
            && request.resource.data.status == 'entregado')
        );
    }

    function isAdminStockRestoration() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && resource.data.stock is number
        && request.resource.data.stock is number
        && request.resource.data.stock >= resource.data.stock;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && !('cost' in request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && !('cost' in request.resource.data))
        || isAdminStockRestoration();
    }

    match /productCosts/{productId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['cost', 'updatedAt'])
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if false;
      allow read: if isAdmin();
      allow update: if isAdmin() && validOrderStatusChange();
      allow delete: if false;
    }

    match /sales/{saleId} {
      allow read, create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /deletedSales/{saleId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['saleId', 'deletedAt'])
        && request.resource.data.saleId == saleId
        && request.resource.data.deletedAt is timestamp;
      allow update, delete: if false;
    }

    match /receivables/{receivableId} {
      function validReceivable(data) {
        return data.keys().hasAll([
            'saleId', 'clientName', 'clientPhone', 'total', 'paidTotal',
            'balance', 'status', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'saleId', 'clientName', 'clientPhone', 'total', 'paidTotal',
            'balance', 'status', 'createdAt', 'updatedAt'
          ])
          && data.saleId is string
          && data.saleId.size() > 0
          && data.clientName is string
          && data.clientPhone is string
          && data.total is number
          && data.paidTotal is number
          && data.balance is number
          && data.total > 0
          && data.paidTotal >= 0
          && data.balance >= 0
          && data.total == data.paidTotal + data.balance
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.status == (data.balance == 0 ? 'paid' : 'open');
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && validReceivable(request.resource.data);
      allow update: if isAdmin()
        && validReceivable(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidTotal', 'balance', 'status', 'updatedAt'
        ])
        && request.resource.data.total == resource.data.total
        && request.resource.data.saleId == resource.data.saleId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.clientPhone == resource.data.clientPhone
        && request.resource.data.paidTotal > resource.data.paidTotal
        && request.resource.data.balance < resource.data.balance;
      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['amount', 'date', 'note'])
          && request.resource.data.keys().hasAll(['amount', 'date'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && (!('note' in request.resource.data)
            || (request.resource.data.note is string
              && request.resource.data.note.size() <= 160));
        allow update, delete: if false;
      }
    }

    match /storefront/{settingsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
